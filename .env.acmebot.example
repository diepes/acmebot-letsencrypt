# Copy this file to .env.acmebot and fill in real values before running:
#   cp .env.acmebot.example .env.acmebot
#   docker compose build
#   docker compose run --rm acmebot
#
# Note: this is deliberately NOT named .env — the repo root already has an
# unrelated .env (GH_TOKEN for other tooling); reusing that name would either
# clobber it or leak GH_TOKEN into this container, and docker compose
# auto-loads a root .env for its own variable substitution regardless.
#
# See DockerEntrypoint.sh and CONTEXT.md for the full description of each
# variable and the DNS persist mode rollout plan.

# --- Required ---------------------------------------------------------------
DOMAIN=example.com
# Email address registered with Let's Encrypt (use a real address).
ACME_EMAIL=you@example.org
# acme.sh dns hook to use for DNS-01 validation: dns_azure | dns_aws
DNS_PROVIDER=dns_azure
AZURE_KEYVAULT_NAME=my-keyvault

# --- Optional -----------------------------------------------------------------
# SAN_DOMAINS="www.example.com another.example.com"
# AZURE_KEYVAULT_CERT_NAME=example-com

# --- DNS provider credentials (per acme.sh dnsapi docs) ----------------------
# Only set the block matching DNS_PROVIDER above.

# dns_azure:
# AZUREDNS_SUBSCRIPTIONID=
# AZUREDNS_TENANTID=
# AZUREDNS_APPID=
# AZUREDNS_CLIENTSECRET=

# dns_aws:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
