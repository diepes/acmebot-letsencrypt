# Copy this file to .env.acmebot and fill in real values before running:
#   cp .env.acmebot.example .env.acmebot
#   docker compose build
#   docker compose run --rm bootstrap   # one-time
#   docker compose run --rm acmebot     # issue/renew + Key Vault import
#
# Note: this is deliberately NOT named .env — the repo root already has an
# unrelated .env (GH_TOKEN for other tooling); reusing that name would either
# clobber it or leak GH_TOKEN into this container, and docker compose
# auto-loads a root .env for its own variable substitution regardless.
#
# See acme-bootstrap.sh, acme-cron-update.sh, and CONTEXT.md for the full
# description of each variable and the DNS persist mode flow.

# --- Required (used by both acme-bootstrap.sh and acme-cron-update.sh) ------
# Comma separated list of domains for the certificate's SAN set. Wildcard
# entries (e.g. *.example.com) are supported. acme-cron-update.sh treats the
# first entry as the primary domain (CN); order doesn't matter for bootstrap.
ACME_DOMAINS=example.com,*.example.com
# Email address registered with Let's Encrypt (use a real address).
ACME_EMAIL=you@example.org

# --- Required (acme-cron-update.sh only) -------------------------------------
AZURE_KEYVAULT_NAME=my-keyvault

# --- Optional -----------------------------------------------------------------
# ACME server to target. Defaults to letsencrypt_test (staging) so debugging
# can't hit production rate limits; set letsencrypt deliberately for real,
# trusted certificates (see CONTEXT.md).
# ACME_SERVER=letsencrypt
# AZURE_KEYVAULT_CERT_NAME=example-com
